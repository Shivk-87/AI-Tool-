@@ -0,0 +1,80 @@
+# Values for Helm chart including Vault, PVCs, Milvus, and resource settings
+
+replicaCount: 2
+
+image:
+  repository: ghcr.io/your-org/codebase-steward
+  pullPolicy: IfNotPresent
+  tag: "latest"
+
+service:
+  type: ClusterIP
+  port: 8000
+
+resources:
+  requests:
+    cpu: "500m"
+    memory: "1Gi"
+  limits:
+    cpu: "1000m"
+    memory: "2Gi"
+
+nodeSelector: {}
+
+tolerations: []
+
+persistence:
+  enabled: true
+  modelStorage:
+    enabled: true
+    storageClass: ""
+    accessMode: ReadWriteOnce
+    size: 200Gi
+  milvus:
+    enabled: true
+    storageClass: ""
+    accessMode: ReadWriteOnce
+    size: 500Gi
+
+milvus:
+  enabled: true
+  host: "milvus.default.svc.cluster.local"
+  port: 19530
+
+modelServing:
+  image: ghcr.io/huggingface/text-generation-inference:latest
+  gpu:
+    enabled: true
+    requests: 1
+    limits: 1
+  nodeSelector:
+    kubernetes.io/role: gpu
+  tolerations:
+    - key: "nvidia.com/gpu"
+      operator: "Exists"
+      effect: "NoSchedule"
+
+vault:
+  enabled: true
+  address: "https://vault.example.local:8200"
+  role: "k8s-role-codebase-steward"
+  # path where secrets are stored, e.g. secret/data/codebase-steward
+  secretPath: "secret/data/codebase-steward"
+  tokenPath: "/vault/token" # where Vault token will be written by init container
+
+secrets:
+  modelCredentialsSecret: ""
diff --git a/charts/codebase-steward/templates/deployment.yaml b/charts/codebase-steward/templates/deployment.yaml
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/charts/codebase-steward/templates/deployment.yaml
@@ -0,0 +1,209 @@
+{{- $values := .Values -}}
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: {{ include "codebase-steward.fullname" . | default "codebase-steward" }}
+  labels:
+    app: {{ include "codebase-steward.name" . | default "codebase-steward" }}
+spec:
+  replicas: {{ .Values.replicaCount }}
+  selector:
+    matchLabels:
+      app: codebase-steward
+  template:
+    metadata:
+      labels:
+        app: codebase-steward
+      annotations:
+        prometheus.io/scrape: "true"
+        prometheus.io/port: "8000"
+    spec:
+      {{- if .Values.vault.enabled }}
+      serviceAccountName: {{ include "codebase-steward.fullname" . }}-sa
+      {{- end }}
+      containers:
+        - name: backend
+          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
+          imagePullPolicy: {{ .Values.image.pullPolicy }}
+          ports:
+            - containerPort: 8000
+          env:
+            - name: MILVUS_HOST
+              value: "{{ .Values.milvus.host }}"
+            - name: MILVUS_PORT
+              value: "{{ .Values.milvus.port }}"
+            - name: DATA_DIR
+              value: "/data"
+            {{- if .Values.vault.enabled }}
+            - name: VAULT_ADDR
+              value: "{{ .Values.vault.address }}"
+            - name: VAULT_TOKEN_FILE
+              value: "{{ .Values.vault.tokenPath }}"
+            {{- end }}
+          resources:
+            requests:
+              cpu: {{ .Values.resources.requests.cpu }}
+              memory: {{ .Values.resources.requests.memory }}
+            limits:
+              cpu: {{ .Values.resources.limits.cpu }}
+              memory: {{ .Values.resources.limits.memory }}
+          volumeMounts:
+            - name: data
+              mountPath: /data
+            {{- if .Values.vault.enabled }}
+            - name: vault-token
+              mountPath: {{ .Values.vault.tokenPath }}
+              subPath: token
+            {{- end }}
+          readinessProbe:
+            httpGet:
+              path: /health
+              port: 8000
+            initialDelaySeconds: 10
+            periodSeconds: 10
+            failureThreshold: 3
+          livenessProbe:
+            httpGet:
+              path: /health
+              port: 8000
+            initialDelaySeconds: 30
+            periodSeconds: 20
+            failureThreshold: 5
+      volumes:
+        - name: data
+          {{- if .Values.persistence.enabled }}
+          persistentVolumeClaim:
+            claimName: {{ include "codebase-steward.fullname" . }}-data-pvc
+          {{- else }}
+          emptyDir: {}
+          {{- end }}
+        {{- if .Values.vault.enabled }}
+        - name: vault-token
+          emptyDir: {}
+        {{- end }}
+      {{- if .Values.vault.enabled }}
+      initContainers:
+        - name: vault-init
+          image: hashicorp/vault:1.16.0
+          command: ["/bin/sh","-c"]
+          args:
+            - |
+              echo "Fetching secrets from Vault..."
+              # Using vault CLI to login via Kubernetes auth (service account role)
+              vault login -method=kubernetes role={{ .Values.vault.role }} > /tmp/vault-login.out || true
+              vault kv get -format=json {{ .Values.vault.secretPath }} > /tmp/secret.json || true
+              if [ -f /tmp/vault-login.out ]; then
+                # write token to shared volume
+                cat /tmp/vault-login.out | jq -r '.auth.client_token' > {{ .Values.vault.tokenPath }} || true
+              fi
+              cp /tmp/secret.json /vault/token/secret.json || true
+          volumeMounts:
+            - name: vault-token
+              mountPath: /vault/token
+      {{- end }}
